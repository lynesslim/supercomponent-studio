{
  "id": "horizontal-pinned-cards",
  "name": "Horizontal Draggable Cards",
  "settings": [
    {
      "tab": "content",
      "section": "Cards Content",
      "id": "cards",
      "type": "repeater",
      "label": "Cards List",
      "title_field": "{{{ index }}} - {{{ title }}}",
      "fields": [
        {
          "id": "index",
          "type": "text",
          "label": "Card Index",
          "default": "01 / 08"
        },
        {
          "id": "title",
          "type": "text",
          "label": "Card Title",
          "default": "Card Title"
        },
        {
          "id": "image",
          "type": "image",
          "label": "Background Image"
        },
        {
          "id": "icon_source",
          "type": "select",
          "label": "Icon Source",
          "default": "svg",
          "options": [
            {
              "value": "svg",
              "label": "Custom SVG (Raw Code)"
            },
            {
              "value": "library",
              "label": "Icon Library (FontAwesome / Elementor)"
            }
          ]
        },
        {
          "id": "icon_library",
          "type": "icons",
          "label": "Choose Icon from Library",
          "default": {
            "value": "fas fa-star",
            "library": "fa-solid"
          },
          "condition": {
            "icon_source": "library"
          }
        },
        {
          "id": "icon_svg",
          "type": "textarea",
          "label": "Icon (Raw SVG)",
          "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>",
          "condition": {
            "icon_source": "svg"
          }
        },
        {
          "id": "link",
          "type": "url",
          "label": "Card Link"
        }
      ],
      "default": [
