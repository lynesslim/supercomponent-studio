    {
      "tab": "content",
      "section": "Edge Fade",
      "id": "show_edge_fade",
      "type": "switcher",
      "label": "Enable Edge Fades",
      "default": "yes"
    },
    {
      "tab": "style",
      "section": "Card Dimensions",
      "id": "card_width",
      "type": "slider",
      "label": "Card Width (px)",
      "unit": "px",
      "min": 220,
      "max": 500,
      "step": 10,
      "default": {
        "size": 320,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Card Dimensions",
      "id": "card_height",
      "type": "slider",
      "label": "Card Height (px)",
      "unit": "px",
      "min": 280,
      "max": 700,
      "step": 10,
      "default": {
        "size": 420,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Card Dimensions",
      "id": "card_gap",
      "type": "slider",
      "label": "Card Gap (px)",
      "unit": "px",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": {
        "size": 20,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Card Dimensions",
      "id": "card_radius",
      "type": "slider",
      "label": "Card Border Radius (px)",
      "unit": "px",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": {
        "size": 18,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Card Dimensions",
      "id": "stage_padding_y",
      "type": "slider",
      "label": "Stage Vertical Padding (px)",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": {
        "size": 30,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "accent_color",
      "type": "color",
      "label": "Accent Rule Color",
      "default": "#4F6BFF"
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "card_title_color",
      "type": "color",
      "label": "Title Color",
      "default": "#FFFFFF"
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "card_index_color",
      "type": "color",
      "label": "Index Color",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "icon_color",
      "type": "color",
      "label": "Icon Color",
      "default": "#FFFFFF"
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "overlay_top_color",
      "type": "color",
      "label": "Card Overlay Top",
      "default": "rgba(10, 12, 20, 0.35)"
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "overlay_bottom_color",
      "type": "color",
      "label": "Card Overlay Bottom",
      "default": "rgba(10, 12, 20, 0.85)"
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "edge_fade_color",
      "type": "color",
      "label": "Edge Fade Color",
      "default": "#FFFFFF",
      "condition": {
        "show_edge_fade": "yes"
      }
    },
    {
      "tab": "style",
      "section": "Colors & Overlays",
      "id": "edge_fade_width",
      "type": "slider",
      "label": "Edge Fade Width (px)",
      "unit": "px",
      "min": 20,
      "max": 180,
      "step": 5,
      "default": {
        "size": 60,
        "unit": "px"
      },
      "condition": {
        "show_edge_fade": "yes"
      }
    },
    {
      "tab": "style",
      "section": "Indicator Rule",
      "id": "rule_width",
      "type": "slider",
      "label": "Rule Width (px)",
      "unit": "px",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": {
        "size": 32,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Indicator Rule",
      "id": "rule_height",
      "type": "slider",
      "label": "Rule Height (px)",
      "unit": "px",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": {
        "size": 3,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Indicator Rule",
      "id": "rule_radius",
      "type": "slider",
      "label": "Rule Border Radius (px)",
      "unit": "px",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": {
        "size": 2,
        "unit": "px"
      }
    },
    {
      "tab": "style",
      "section": "Typography",
      "id": "title_typography",
      "type": "typography",
      "label": "Card Title Typography"
    },
    {
      "tab": "style",
      "section": "Typography",
      "id": "index_typography",
      "type": "typography",
      "label": "Card Index Typography"
    },
    {
      "tab": "style",
      "section": "Drag & Interaction",
      "id": "enable_mousewheel",
      "type": "switcher",
      "label": "Mouse Wheel Horizontal Scroll",
      "default": "yes"
    },
    {
      "tab": "style",
      "section": "Drag & Interaction",
      "id": "edge_resistance",
      "type": "slider",
      "label": "Edge Drag Resistance",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": {
        "size": 0.65
      }
    }
  ]
}
