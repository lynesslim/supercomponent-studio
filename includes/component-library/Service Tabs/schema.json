      "min": 350,
      "max": 900,
      "step": 10,
      "tab": "style",
      "section": "Dimensions & Sizing"
    },
    {
      "id": "tab_collapsed_width",
      "type": "slider",
      "label": "Collapsed Tab Width",
      "default": {
        "size": 76,
        "unit": "px"
      },
      "min": 50,
      "max": 140,
      "step": 2,
