    {
      "id": "text_color",
      "type": "color",
      "label": "Heading & Text Color",
      "default": "#283746",
      "tab": "style",
      "section": "Typography & Colors"
    },
    {
      "id": "muted_color",
      "type": "color",
      "label": "Muted Description Color",
      "default": "#607080",
      "tab": "style",
      "section": "Typography & Colors"
    },
    {
      "id": "pill_border_color",
      "type": "color",
