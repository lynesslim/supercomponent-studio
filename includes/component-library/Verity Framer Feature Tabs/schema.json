{
  "id": "verity-framer-feature-tabs",
  "name": "Verity / Framer Feature Tabs",
  "settings": [
    {
      "tab": "content",
      "section": "Feature Tabs",
      "id": "tabs",
      "type": "repeater",
      "label": "Feature Tabs",
      "title_field": "{{{ title }}}",
      "fields": [
        {
          "id": "tab_id",
          "type": "text",
          "label": "Tab ID",
          "default": "0"
        },
        {
          "id": "number",
          "type": "text",
          "label": "Number",
          "default": "01"
        },
        {
          "id": "title",
          "type": "text",
          "label": "Title",
          "default": "Recurring tasks"
        },
        {
          "id": "description",
          "type": "textarea",
          "label": "Description",
          "default": "The reports, updates, and check-ins your team does on repeat now happen automatically — on schedule, every time, without anyone lifting a finger."
        },
        {
          "id": "icon",
          "type": "icons",
          "label": "Tab Icon",
          "default": {
            "value": "fas fa-sync-alt",
            "library": "fa-solid"
          }
        },
        {
          "id": "dashboard_image",
          "type": "image",
          "label": "Dashboard Image"
        },
        {
          "id": "alt",
          "type": "text",
          "label": "Dashboard Alt Text"
        }
      ],
      "default": [
        {
          "tab_id": "0",
          "number": "01",
          "title": "Recurring tasks",
          "description": "The reports, updates, and check-ins your team does on repeat now happen automatically — on schedule, every time, without anyone lifting a finger.",
          "icon": {
            "value": "fas fa-sync-alt",
            "library": "fa-solid"
          },
          "dashboard_image": {
            "url": "https://framerusercontent.com/images/gGHkSTfi9EE0JCyl1GqMWyhWjjw.png?width=1531&height=1089"
          },
          "alt": "Scheduled tasks dashboard"
        },
        {
          "tab_id": "1",
          "number": "02",
          "title": "Lead routing",
          "description": "Route every new lead to the right person, workflow, or AI agent automatically, with the right context attached.",
          "icon": {
            "value": "fas fa-route",
            "library": "fa-solid"
          },
          "dashboard_image": {
            "url": "https://framerusercontent.com/images/ZdbKfiKUHNsEj58WfrEd4v7O4M.png?width=1531&height=1089"
          },
          "alt": "Lead routing dashboard"
        },
        {
          "tab_id": "2",
          "number": "03",
          "title": "Ticket triage",
          "description": "Automatically classify, prioritize, and route incoming support tickets so your team can focus on the work that matters.",
          "icon": {
            "value": "fas fa-inbox",
            "library": "fa-solid"
          },
          "dashboard_image": {
            "url": "https://framerusercontent.com/images/dMMIpvTBZYg5OTSRDFF6Jjyttw.png?width=1531&height=1089"
          },
          "alt": "Ticket triage dashboard"
        },
        {
          "tab_id": "3",
          "number": "04",
          "title": "Live reporting",
          "description": "See live performance, automation activity, and important business signals in one continuously updated reporting layer.",
          "icon": {
            "value": "fas fa-chart-line",
            "library": "fa-solid"
          },
          "dashboard_image": {
            "url": "https://framerusercontent.com/images/Q6yMkkxQ2S0fq4gCsU0ROwVsHo.png?width=1531&height=1089"
          },
          "alt": "Live reporting dashboard"
        }
      ]
    },
