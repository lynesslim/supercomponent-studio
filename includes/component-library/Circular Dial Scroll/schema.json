{
  "id": "circular-dial-scroll",
  "name": "Circular Dial Scroll",
  "settings": [
    {
      "id": "show_eyebrow",
      "type": "switcher",
      "label": "Show Eyebrow",
      "default": "yes",
      "tab": "content",
      "section": "Header Content"
    },
    {
      "id": "eyebrow_text",
      "type": "text",
      "label": "Eyebrow Text",
      "default": "Process",
      "tab": "content",
      "section": "Header Content",
      "condition": {
        "show_eyebrow": "yes"
      }
    },
    {
      "id": "stages",
      "type": "repeater",
      "label": "Process Stages",
      "tab": "content",
      "section": "Stages List",
      "title_field": "{{{ number }}} - {{{ title }}}",
      "fields": [
        {
          "id": "number",
          "type": "text",
          "label": "Stage Number",
          "default": "01"
        },
        {
          "id": "title",
          "type": "text",
          "label": "Stage Title",
          "default": "Stage Title"
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "Stage Description",
          "default": "Stage description content goes here."
        },
        {
          "id": "bg_image",
          "type": "image",
          "label": "Stage Background Image"
        }
      ],
      "default": [
        {
          "number": "01",
          "title": "Material selection",
          "body": "We begin by choosing materials for performance, tactility and long-term durability.",
          "bg_image": {
            "url": "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=1600&auto=format&fit=crop"
          }
        },
        {
          "number": "02",
          "title": "Precision shaping",
          "body": "Each component is formed with controlled tolerances to preserve the intended geometry.",
          "bg_image": {
            "url": "https://images.unsplash.com/photo-1581092335397-9583fe92d232?q=80&w=1600&auto=format&fit=crop"
          }
        },
        {
          "number": "03",
          "title": "Surface refinement",
          "body": "Textures and finishes are developed to create depth, grip and a distinctive visual rhythm.",
          "bg_image": {
            "url": "https://images.unsplash.com/photo-1504384308090-c894fdcc538d?q=80&w=1600&auto=format&fit=crop"
          }
        },
        {
          "number": "04",
          "title": "System assembly",
          "body": "Individual parts are aligned and assembled into one coherent, high-performance structure.",
          "bg_image": {
            "url": "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=1600&auto=format&fit=crop"
          }
        },
        {
          "number": "05",
          "title": "Final validation",
          "body": "The complete product is tested, adjusted and approved before it reaches its final form.",
          "bg_image": {
            "url": "https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?q=80&w=1600&auto=format&fit=crop"
          }
        }
      ]
    },
    {
      "id": "show_counter",
      "type": "switcher",
      "label": "Show Counter",
      "default": "yes",
      "tab": "content",
      "section": "Counter Settings"
    },
    {
      "id": "counter_separator",
      "type": "text",
      "label": "Counter Separator",
      "default": "/",
      "tab": "content",
      "section": "Counter Settings",
      "condition": {
        "show_counter": "yes"
      }
    },
    {
      "id": "section_height",
      "type": "slider",
      "label": "Section Height (vh)",
      "unit": "vh",
      "min": 50,
      "max": 150,
      "step": 1,
      "default": {
        "size": 100,
        "unit": "vh"
      },
      "tab": "style",
      "section": "Layout & Sizing"
    },
    {
      "id": "section_min_height",
      "type": "slider",
      "label": "Section Minimum Height (px)",
      "unit": "px",
      "min": 400,
      "max": 1400,
      "step": 10,
      "default": {
        "size": 720,
        "unit": "px"
      },
      "tab": "style",
      "section": "Layout & Sizing"
    },
    {
      "id": "content_max_width",
      "type": "slider",
      "label": "Content Max Width (px)",
      "unit": "px",
      "min": 280,
      "max": 900,
      "step": 10,
      "default": {
        "size": 480,
        "unit": "px"
      },
      "tab": "style",
      "section": "Layout & Sizing"
    },
    {
      "id": "scrub_distance",
      "type": "slider",
      "label": "Scroll Distance per Stage (px)",
      "unit": "px",
      "min": 300,
      "max": 2500,
      "step": 50,
      "default": {
        "size": 900,
        "unit": "px"
      },
      "tab": "style",
      "section": "Layout & Sizing"
    },
    {
      "id": "bg_mode",
      "type": "select",
      "label": "Background Mode",
      "default": "dynamic",
      "options": [
        {
          "value": "dynamic",
          "label": "Per-Stage Background (Changes on Scroll)"
        },
        {
          "value": "fixed",
          "label": "Fixed Background (Global Image)"
        },
        {
          "value": "none",
          "label": "None / Transparent"
        }
      ],
      "tab": "style",
      "section": "Background Settings"
    },
    {
      "id": "bg_image",
      "type": "image",
      "label": "Fixed / Fallback Background Image",
      "default": {
        "url": "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=1600&auto=format&fit=crop"
      },
      "tab": "style",
      "section": "Background Settings"
    },
    {
      "id": "bg_overlay_color",
      "type": "color",
      "label": "Background Overlay Color",
      "default": "rgba(0, 0, 0, 0.45)",
      "tab": "style",
      "section": "Background Settings"
    },
    {
      "id": "bg_transition_duration",
      "type": "slider",
      "label": "Background Transition Duration (s)",
      "unit": "s",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "default": {
        "size": 0.6,
        "unit": "s"
      },
      "tab": "style",
      "section": "Background Settings"
    },
    {
      "id": "eyebrow_typography",
      "type": "typography",
      "label": "Eyebrow Typography",
      "tab": "style",
      "section": "Typography"
    },
    {
      "id": "title_typography",
      "type": "typography",
      "label": "Title Typography",
      "tab": "style",
      "section": "Typography"
    },
    {
      "id": "body_typography",
      "type": "typography",
      "label": "Body Typography",
      "tab": "style",
      "section": "Typography"
    },
    {
      "id": "counter_typography",
      "type": "typography",
      "label": "Counter Typography",
      "tab": "style",
      "section": "Typography"
    },
    {
      "id": "dial_label_typography",
      "type": "typography",
      "label": "Dial Numbers Typography",
      "tab": "style",
      "section": "Typography"
    },
    {
      "id": "eyebrow_color",
      "type": "color",
      "label": "Eyebrow Color",
      "default": "rgba(255, 255, 255, 0.62)",
      "tab": "style",
      "section": "Content Colors"
    },
    {
      "id": "title_color",
      "type": "color",
      "label": "Title Color",
      "default": "#ffffff",
      "tab": "style",
      "section": "Content Colors"
    },
    {
      "id": "body_color",
      "type": "color",
      "label": "Body Color",
      "default": "rgba(255, 255, 255, 0.7)",
      "tab": "style",
      "section": "Content Colors"
    },
    {
      "id": "counter_color",
      "type": "color",
      "label": "Counter Color",
      "default": "rgba(255, 255, 255, 0.48)",
      "tab": "style",
      "section": "Content Colors"
    },
    {
      "id": "active_label_color",
      "type": "color",
      "label": "Active Dial Number Color",
      "default": "#ffffff",
      "tab": "style",
      "section": "Dial Appearance"
    },
    {
      "id": "inactive_label_color",
      "type": "color",
      "label": "Inactive Dial Number Color",
      "default": "rgba(255, 255, 255, 0.28)",
      "tab": "style",
      "section": "Dial Appearance"
    },
    {
      "id": "dial_line_color",
      "type": "color",
      "label": "Dial Ring Color",
      "default": "rgba(255, 255, 255, 0.62)",
      "tab": "style",
      "section": "Dial Appearance"
    },
    {
      "id": "dial_line_width",
      "type": "slider",
      "label": "Dial Ring Width (px)",
      "unit": "px",
      "min": 0.5,
      "max": 6,
      "step": 0.5,
      "default": {
        "size": 1,
        "unit": "px"
      },
      "tab": "style",
      "section": "Dial Appearance"
    },
    {
      "id": "dial_dot_color",
      "type": "color",
      "label": "Indicator Dot Color",
      "default": "#ffffff",
      "tab": "style",
      "section": "Dial Appearance"
    },
    {
      "id": "dial_dot_glow_color",
      "type": "color",
      "label": "Indicator Dot Glow Color",
      "default": "rgba(255, 255, 255, 0.75)",
      "tab": "style",
      "section": "Dial Appearance"
    },
    {
      "id": "dial_dot_size",
      "type": "slider",
      "label": "Indicator Dot Radius (px)",
      "unit": "px",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": {
        "size": 5,
        "unit": "px"
      },
      "tab": "style",
      "section": "Dial Appearance"
    }
  ]
}
